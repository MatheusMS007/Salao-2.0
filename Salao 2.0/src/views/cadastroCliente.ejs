<%- include('header') %>

        <h2>Cadastrar Cliente</h2>

        <!-- action="/clientes" diz para onde os dados vão quando clicar em salvar -->
        <!-- method="POST" diz que estamos enviando dados novos -->
        <form action="/clientes" method="POST" class="formulario">

            <label>Nome completo</label>
            <input type="text" name="nome" placeholder="Ex: Maria Silva" required /> <!-- required = obrigatório -->

            <label>Telefone</label>
            <input type="text" name="telefone" placeholder="Ex: (11) 99999-9999" required />

            <label>Email (opcional)</label>
            <input type="email" name="email" placeholder="Ex: maria@email.com" />

            <div class="botoes">
                <button type="submit" class="btn-salvar">Salvar</button>                  <!-- envia o formulário -->
                <a href="/clientes" class="btn-cancelar">Cancelar</a> <!-- volta para a lista sem salvar -->
            </div>

        </form>
    </main>

<%- include('footer') %>
