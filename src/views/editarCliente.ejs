<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Cliente</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>💇 Salão de Beleza</h1>
        <nav>
            <a href="/clientes" class="btn-nav">Clientes</a>
            <a href="/agendamentos" class="btn-nav">Agendamentos</a>
        </nav>
    </header>

    <main>
        <h2>Editar Cliente</h2>

        <!-- action aponta para o id do cliente que está sendo editado -->
        <!-- ?_method=PUT é o truque para usar o método PUT no HTML -->
        <form action="/clientes/<%= cliente.idCliente %>?_method=PUT" method="POST" class="formulario">

            <label>Nome completo</label>
            <!-- value="<%= cliente.nome %>" já preenche o campo com o valor atual -->
            <input type="text" name="nome" value="<%= cliente.nome %>" required />

            <label>Telefone</label>
            <input type="text" name="telefone" value="<%= cliente.telefone %>" required />

            <label>Email (opcional)</label>
            <input type="email" name="email" value="<%= cliente.email || '' %>" />

            <div class="botoes">
                <button type="submit" class="btn-salvar">Salvar</button>
                <a href="/clientes" class="btn-cancelar">Cancelar</a>
            </div>

        </form>
    </main>

</body>
</html>
