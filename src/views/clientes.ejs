<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salão de Beleza - Clientes</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- importa o arquivo de estilos -->
</head>
<body>

    <header>
        <h1>💇 Salão de Beleza</h1>
        <nav>
            <a href="/clientes" class="btn-nav">Clientes</a>
            <a href="/agendamentos" class="btn-nav">Agendamentos</a>
        </nav>
    </header>

    <main>
        <h2>Clientes Cadastrados</h2>

        <!-- Botão para abrir o formulário de cadastro -->
        <a href="/cadastroCliente" class="btn-novo">+ Novo Cliente</a>

        <!-- Tabela que mostra todos os clientes -->
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <!-- o forEach percorre cada cliente e cria uma linha na tabela -->
                <% clientes.forEach(cliente => { %>
                <tr>
                    <td><%= cliente.nome %></td>           <!-- mostra o nome do cliente -->
                    <td><%= cliente.telefone %></td>       <!-- mostra o telefone -->
                    <td><%= cliente.email || '-' %></td>   <!-- mostra o email ou '-' se estiver vazio -->
                    <td>
                        <!-- botão para editar o cliente -->
                        <a href="/editarCliente/<%= cliente.idCliente %>" class="btn-editar">Editar</a>

                        <!-- formulário para apagar o cliente -->
                        <form action="/clientes/<%= cliente.idCliente %>?_method=DELETE" method="POST" style="display:inline">
                            <button type="submit" class="btn-apagar" data-id="<%= cliente.idCliente %>">Apagar</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </main>

<script>
  // Escuta o clique em todos os botões de apagar
  document.querySelectorAll('.btn-apagar').forEach(function(botao) {
    botao.closest('form').addEventListener('submit', function(e) {
      if (!confirm('Tem certeza que deseja apagar este cliente?')) {
        e.preventDefault(); // cancela o envio se o usuário clicar em "Cancelar"
      }
    });
  });
</script>
</body>
</html>
