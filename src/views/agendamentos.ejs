<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salão de Beleza - Agendamentos</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- importa o arquivo de estilos -->
</head>
<body>

    <header>
        <h1>💇 Salão de Beleza</h1>
        <nav>
            <a href="/clientes" class="btn-nav">Clientes</a>
            <a href="/agendamentos" class="btn-nav">Agendamentos</a>
        </nav>
    </header>

    <main>
        <h2>Agendamentos</h2>

        <!-- Botão para abrir o formulário de novo agendamento -->
        <a href="/cadastroAgendamento" class="btn-novo">+ Novo Agendamento</a>

        <!-- Tabela que mostra todos os agendamentos -->
        <table>
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Serviço</th>
                    <th>Data</th>
                    <th>Hora</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <!-- percorre cada agendamento e cria uma linha na tabela -->
                <% agendamentos.forEach(agendamento => { %>
                <tr>
                    <td><%= agendamento.nomeCliente %></td> <!-- mostra o nome do cliente -->
                    <td><%= agendamento.servico %></td>     <!-- mostra o serviço (escova, tranças, manicure) -->
                    <td><%= agendamento.data %></td>        <!-- mostra a data -->
                    <td><%= agendamento.hora %></td>        <!-- mostra a hora -->
                    <td>
                        <!-- mostra o status com cor diferente dependendo se é pendente ou realizado -->
                        <span class="status-<%= agendamento.status %>">
                            <%= agendamento.status %>
                        </span>
                    </td>
                    <td>
                        <!-- botão de realizado só aparece se o status for pendente -->
                        <% if (agendamento.status === 'pendente') { %>
                            <form action="/agendamentos/<%= agendamento.idAgendamento %>/realizado?_method=PATCH" method="POST" style="display:inline">
                                <button type="submit" class="btn-realizado">✔ Realizado</button>
                            </form>
                        <% } %>

                        <!-- botão para editar o agendamento -->
                        <a href="/editarAgendamento/<%= agendamento.idAgendamento %>" class="btn-editar">Editar</a>

                        <!-- botão para apagar o agendamento -->
                        <form action="/agendamentos/<%= agendamento.idAgendamento %>?_method=DELETE" method="POST" style="display:inline">
                            <button type="submit" class="btn-apagar" data-id="<%= agendamento.idAgendamento %>">Apagar</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </main>

<script>
  // Escuta o clique em todos os botões de apagar
  document.querySelectorAll('.btn-apagar').forEach(function(botao) {
    botao.closest('form').addEventListener('submit', function(e) {
      if (!confirm('Tem certeza que deseja apagar este agendamento?')) {
        e.preventDefault(); // cancela o envio se o usuário clicar em "Cancelar"
      }
    });
  });
</script>
</body>
</html>
