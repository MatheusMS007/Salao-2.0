<%- include('header') %>

<section class="lista">
    <div class="topo-lista">
        <h2>Agendamentos</h2>
        <a href="/cadastroAgendamento" class="btn-novo">+ Novo Agendamento</a>
    </div>

    <% if (agendamentos.length === 0) { %>
        <p>Nenhum agendamento cadastrado ainda.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Serviço</th>
                    <th>Data</th>
                    <th>Hora</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% agendamentos.forEach(agendamento => { %>
                <tr>
                    <td><%= agendamento.nomeCliente %></td>
                    <td><%= agendamento.servico %></td>
                    <td><%= agendamento.data %></td>
                    <td><%= agendamento.hora %></td>
                    <td>
                        <span class="status-<%= agendamento.status %>">
                            <%= agendamento.status %>
                        </span>
                    </td>
                    <td>
                        <% if (agendamento.status === 'pendente') { %>
                            <form action="/agendamentos/<%= agendamento.idAgendamento %>/realizado?_method=PATCH" method="POST" style="display:inline">
                                <button type="submit" class="btn-realizado">✔ Realizado</button>
                            </form>
                        <% } %>
                        <a href="/editarAgendamento/<%= agendamento.idAgendamento %>" class="btn-editar">Editar</a>
                        <form action="/agendamentos/<%= agendamento.idAgendamento %>?_method=DELETE" method="POST" style="display:inline">
                            <button type="submit" class="btn-apagar" data-id="<%= agendamento.idAgendamento %>">Apagar</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</section>

<script>
  // Escuta o clique em todos os botões de apagar
  document.querySelectorAll('.btn-apagar').forEach(function(botao) {
    botao.closest('form').addEventListener('submit', function(e) {
      if (!confirm('Tem certeza que deseja apagar este agendamento?')) {
        e.preventDefault(); // cancela o envio se o usuário clicar em "Cancelar"
      }
    });
  });
</script>
<%- include('footer') %>
