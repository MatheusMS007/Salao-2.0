<%- include('header') %>

<section class="lista">
    <div class="topo-lista">
        <h2>Salões cadastrados</h2>
    </div>

    <% if (saloes.length === 0) { %>
        <p>Nenhum salão cadastrado ainda.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <!-- COLUNA DE AÇÕES: Permite deletar salões -->
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% saloes.forEach((salao) => { %>
                    <tr>
                        <td><%= salao.idSalao %></td>
                        <td><%= salao.nome %></td>
                        <!-- FORMULÁRIO DE DELETE: Envia requisição DELETE para /saloes/:id -->
                        <!-- JavaScript: form.method muda para DELETE (não existe nativamente em HTML) -->
                        <td>
                            <form method="POST" action="/saloes/<%= salao.idSalao %>?_method=DELETE" style="display: inline;">
                                <button type="submit" class="btn-deletar" onclick="return confirm('Tem certeza que deseja deletar este salão?');">Deletar</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</section>

<%- include('footer') %>
