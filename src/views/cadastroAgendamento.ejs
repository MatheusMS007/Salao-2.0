<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Novo Agendamento</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>💇 Salão de Beleza</h1>
        <nav>
            <a href="/clientes" class="btn-nav">Clientes</a>
            <a href="/agendamentos" class="btn-nav">Agendamentos</a>
        </nav>
    </header>

    <main>
        <h2>Novo Agendamento</h2>

        <form action="/agendamentos" method="POST" class="formulario">

            <label>Cliente</label>
            <select name="idCliente" required> <!-- select é uma lista suspensa para escolher o cliente -->
                <option value="">Selecione o cliente</option>
                <!-- percorre todos os clientes e cria uma opção para cada um -->
                <% clientes.forEach(cliente => { %>
                    <option value="<%= cliente.idCliente %>"><%= cliente.nome %></option>
                <% }) %>
            </select>

            <label>Serviço</label>
            <select name="servico" required>
                <option value="">Selecione o serviço</option>
                <option value="Escova">Escova</option>       <!-- opção fixa de escova -->
                <option value="Tranças">Tranças</option>     <!-- opção fixa de tranças -->
                <option value="Manicure">Manicure</option>   <!-- opção fixa de manicure -->
            </select>

            <label>Data</label>
            <input type="date" name="data" required /> <!-- campo de data com calendário -->

            <label>Hora</label>
            <input type="time" name="hora" required /> <!-- campo de hora -->

            <div class="botoes">
                <button type="submit" class="btn-salvar">Salvar</button>
                <a href="/agendamentos" class="btn-cancelar">Cancelar</a>
            </div>

        </form>
    </main>

</body>
</html>
