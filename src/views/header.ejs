<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salão de Beleza</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>💇 Salão de Beleza</h1>
        <nav>
            <% if (usuario) { %>
                <a href="/clientes" class="btn-nav">Clientes</a>
                
                <% if (usuario.perfil !== 'adm') { %>
                    <a href="/agendamentos" class="btn-nav">Agendamentos</a>
                    <a href="/solicitacoes" class="btn-nav">Solicitações</a>
                <% } %>
                
                <% if (usuario.perfil === 'adm') { %>
                    <a href="/saloes" class="btn-nav">Salões</a>
                    <a href="/cadastroSalao" class="btn-nav">Novo Salão</a>
                    <a href="/cadastroDono" class="btn-nav">Novo Dono</a>
                    <a href="/donos" class="btn-nav">Donos</a>
                <% } %>
            <% } %>
        </nav>
        <% if (usuario) { %>
            <form action="/logout" method="POST" class="form-logout">
                <button type="submit" class="btn-nav">Sair</button>
            </form>
        <% } %>
    </header>

    <main>
