<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Agendamento</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>💇 Salão de Beleza</h1>
        <nav>
            <a href="/clientes" class="btn-nav">Clientes</a>
            <a href="/agendamentos" class="btn-nav">Agendamentos</a>
        </nav>
    </header>

    <main>
        <h2>Editar Agendamento</h2>

        <form action="/agendamentos/<%= agendamento.idAgendamento %>?_method=PUT" method="POST" class="formulario">

            <label>Cliente</label>
            <select name="idCliente" required>
                <option value="">Selecione o cliente</option>
                <% clientes.forEach(cliente => { %>
                    <!-- selected marca o cliente que já estava selecionado -->
                    <option value="<%= cliente.idCliente %>" <%= cliente.idCliente === agendamento.idCliente ? 'selected' : '' %>>
                        <%= cliente.nome %>
                    </option>
                <% }) %>
            </select>

            <label>Serviço</label>
            <select name="servico" required>
                <option value="">Selecione o serviço</option>
                <!-- selected marca o serviço que já estava selecionado -->
                <option value="Escova"   <%= agendamento.servico === 'Escova'   ? 'selected' : '' %>>Escova</option>
                <option value="Tranças"  <%= agendamento.servico === 'Tranças'  ? 'selected' : '' %>>Tranças</option>
                <option value="Manicure" <%= agendamento.servico === 'Manicure' ? 'selected' : '' %>>Manicure</option>
            </select>

            <label>Data</label>
            <input type="date" name="data" value="<%= agendamento.data %>" required />

            <label>Hora</label>
            <input type="time" name="hora" value="<%= agendamento.hora %>" required />

            <div class="botoes">
                <button type="submit" class="btn-salvar">Salvar</button>
                <a href="/agendamentos" class="btn-cancelar">Cancelar</a>
            </div>

        </form>
    </main>

</body>
</html>
